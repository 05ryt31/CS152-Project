(import scheme (chicken io) (chicken string))

(define (find-value key entries) 
    (let ((entry (assoc key entries))) (and entry (cdr entry))))

(define (remove-key key entries)
    (if (null? entries) 
        '()
        (if (= key (caar entries))
            (remove-key key (cdr entries))
            (cons (car entries) (remove-key key (cdr entries))))))

(define (remove-from-order key order)
    (if (null? order) 
        '()
        (if (= key (car order))
            (cdr order)
            (cons (car order) (remove-from-order key (cdr order))))))

(define (touch key order) 
    (append (remove-from-order key order) (list key)))

(define (lru capacity n)
    (let loop ((i 0) (entries '()) (order '()))
        (unless (= i n)
            (let* ((parts (string-split (read-line))) 
                (op (car parts)) (key (string->number (cadr parts))))
            (if (string=? op "get")
                (let ((value (find-value key entries)))
                    (if value (print value) (print -1))
                    (loop (+ i 1) entries (if value (touch key order) order)))
                (let* ((value (string->number (caddr parts)))
                        (existing (assoc key entries))
                        (new-entries (cons (cons key value) (remove-key key entries)))
                        (new-order (touch key order)))
                    (if (and (not existing) (= (length new-order) (+ capacity 1)))
                        (let ((oldest (car new-order)))
                        (loop (+ i 1) (remove-key oldest new-entries) (cdr new-order)))
                        (loop (+ i 1) new-entries new-order))))))))

(define capacity (string->number (read-line)))
(define n (string->number (read-line)))
(lru capacity n)
