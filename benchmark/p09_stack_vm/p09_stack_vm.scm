(import scheme (chicken io) (chicken string))

(define (stack-vm n)
    (let loop ((i 0) (stack '()))
        (unless (= i n)
            (let* ((parts (string-split (read-line))) 
                (op (car parts)))
            (cond 
                ((string=? op "push")
                    (loop (+ i 1) (cons (string->number (cadr parts)) stack)))
                ((string=? op "pop")
                    (if (null? stack) 
                        (begin (print "error") (loop (+ i 1) stack))
                        (loop (+ i 1) (cdr stack))))
                ((or (string=? op "add") (string=? op "mul"))
                    (if (< (length stack) 2)
                        (begin (print "error") (loop (+ i 1) stack))
                        (let ((a (cadr stack)) (b (car stack)))
                            (loop (+ i 1) (cons (if (string=? op "add") (+ a b) (* a b)) (cddr stack))))))
                ((string=? op "dup")
                    (if (null? stack) 
                        (begin (print "error") (loop (+ i 1) stack))
                        (loop (+ i 1) (cons (car stack) stack))))
                ((string=? op "swap")
                    (if (< (length stack) 2) 
                        (begin (print "error") (loop (+ i 1) stack))
                        (loop (+ i 1) (cons (cadr stack) (cons (car stack) (cddr stack))))))
                (else (if (null? stack) 
                    (print "error") 
                    (print (car stack))) (loop (+ i 1) stack)))))))

(stack-vm (string->number (read-line)))
