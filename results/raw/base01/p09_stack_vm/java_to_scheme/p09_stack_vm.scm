(import scheme (chicken base) (chicken io))

(define (main)
  (let loop ()
    (let ((line (read-line)))
      (if (eof-object? line)
          (exit 0)
          (begin
            (process-command line)
            (loop))))))

(define (process-command command)
  (let* ((parts (string-split command))
         (op (car parts)))
    (cond
      ((string=? op "push")
       (push-stack (string->number (cadr parts))))
      ((string=? op "pop")
       (pop-stack))
      ((or (string=? op "add") (string=? op "mul"))
       (binary-op (if (string=? op "add") + *)))
      ((string=? op "dup")
       (dup-stack))
      ((string=? op "swap")
       (swap-stack))
      ((string=? op "print")
       (print-stack-top)))))
      
(define stack '())

(define (push-stack value)
  (set! stack (cons value stack)))

(define (pop-stack)
  (if (null? stack)
      (display "error\n")
      (set! stack (cdr stack))))

(define (binary-op op)
  (if (< (length stack) 2)
      (display "error\n")
      (let* ((b (car stack))
             (a (cadr stack))
             (result (op a b)))
        (pop-stack)
        (pop-stack)
        (push-stack result))))

(define (dup-stack)
  (if (null? stack)
      (display "error\n")
      (push-stack (car stack))))

(define (swap-stack)
  (if (< (length stack) 2)
      (display "error\n")
      (let* ((b (car stack))
             (a (cadr stack)))
        (pop-stack)
        (pop-stack)
        (push-stack a)
        (push-stack b))))

(define (print-stack-top)
  (if (null? stack)
      (display "error\n")
      (display (car stack))
      (newline)))

(main)
