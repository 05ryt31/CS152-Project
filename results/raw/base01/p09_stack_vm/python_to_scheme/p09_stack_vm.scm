(import scheme (chicken base) (chicken io))

(define (main)
  (let ((n (string->number (read-line))))
    (define stack '())
    (do ((i 0 (+ i 1)))
        ((= i n))
      (let* ((line (read-line))
             (parts (string-split line #\Space))
             (op (car parts)))
        (cond
          ((string=? op "push") (set! stack (cons (string->number (cadr parts)) stack)))
          ((string=? op "pop")
           (if (null? stack)
               (display "error\n")
               (set! stack (cdr stack))))
          ((or (string=? op "add") (string=? op "mul"))
           (if (< (length stack) 2)
               (display "error\n")
               (begin
                 (let* ((b (car stack))
                        (a (cadr stack))
                        (result (if (string=? op "add") (+ a b) (* a b))))
                   (set! stack (cons result (cddr stack)))))))
          ((string=? op "dup")
           (if (null? stack)
               (display "error\n")
               (set! stack (cons (car stack) stack))))
          ((string=? op "swap")
           (if (< (length stack) 2)
               (display "error\n")
               (begin
                 (let ((temp (car stack)))
                   (set! stack (cons (cadr stack) (cons temp (cddr stack))))))))
          ((string=? op "print")
           (if (null? stack)
               (display "error\n")
               (begin
                 (display (car stack))
                 (newline))))))))

(main)
