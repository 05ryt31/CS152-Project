(define (calc s)
  (define (*calc s)
    (if (null? s)
      '()
      (let ((x (car s)))
        (cond ((number? x) (cons x (*calc (cdr s))))
              ((eq? x '+) (+ (*calc (list (cadr s))) (*calc (cddr s))))
              ((eq? x '-) (- (*calc (list (cadr s))) (*calc (cddr s))))
              ((eq? x '*)(* (*calc (list (cadr s))) (*calc (cddr s))))
              ((eq? x '/)(/ (*calc (list (cadr s))) (*calc (cddr s))))))))
  (*calc (string->list s)))
 
