(import (scheme base))
(import (scheme read))
(import (scheme write))
 
;; A simple stack implementation using cons cells.
(define (push item stack)
  (cons item stack))
 
(define (pop stack)
  (let ((cell (cons #f stack)))
    (if (null? (cdr cell))
      '()
      (begin
        (set-cdr! cell (cdr (cdr cell)))
        (car cell)))))
 
(define (top stack)
  (if (null? stack)
    #f
    (car stack)))
 
(define (empty? stack)
  (null? stack))
 
;; Returns true if the brackets in the given string are balanced.
(define (balanced-brackets str)
  (let loop ((stack '()) (chars (string->list str)))
    (cond
      ((null? chars)
       (empty? stack))
      ((member (car chars) '(#\( #\[ #\{))
       (loop (push (car chars) stack) (cdr chars)))
      ((member (car chars) '(#\) #\] #\}))
       (if (or (empty? stack)
               (not (eq? (car chars)
                         (case (top stack)
                           ((#\() #\))
                           ((#\{ #\})
                           ((#\[ #\]))))))
         #f
         (loop (pop stack) (cdr chars))))
      (else
       (loop stack (cdr chars))))))
 
;; Tests.
