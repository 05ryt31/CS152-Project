(define (remove-duplicates lst)
  (let loop ((lst lst) (seen '()))
    (cond ((null? lst) '())
          ((member (car lst) seen)
           (loop (cdr lst) seen))
          (else
           (cons (car lst)
                 (loop (cdr lst) (cons (car lst) seen)))))))
 
