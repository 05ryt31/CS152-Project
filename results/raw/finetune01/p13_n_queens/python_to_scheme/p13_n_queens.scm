 
(define (n-queens n)
  (define (safe? cols r c)
    (let loop ((i (- r 1)))
      (cond ((< i 0))
	    ((or (= c (list-ref cols i))
		 (= c (+ (list-ref cols i) (- r i))))
	      #f)
	    (else (loop (- i 1))))))
  (define (solve cols r)
    (if (= r n)
	(list cols)
	(let loop ((c 0))
	  (cond ((= c n))
		((safe? cols r c)
		 (append (solve (cons c cols) (+ r 1))
			 (loop (+ c 1))))
		(else (loop (+ c 1)))))))
  (length (solve '() 0)))
 
